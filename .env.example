# Firebase Configuration (DT-310)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key

# Backend Heroku Config Vars (set in Heroku Dashboard, never commit real secrets)
# ENCRYPTION_KEY=<base64 32-byte AES key>
# JWT_SECRET=<base64 64-byte HMAC key>
# FRONTEND_URL=https://your-heroku-app.herokuapp.com
# COOKIE_SECURE=true
# MAIL_USERNAME=your_smtp_email
# MAIL_PASSWORD=your_smtp_app_password
# ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.org
# ADMIN_BOOTSTRAP_PASSWORD=<strong-initial-password>
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
